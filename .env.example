# AstroGuard — copy to .env.local to override.
# All values below are the built-in defaults; nothing is required to run locally.

# HMAC key for session tokens. CHANGE THIS in any real deployment.
ASTROGUARD_SECRET=astroguard-dev-secret

# Standalone Express mirror (npm run api).
ASTROGUARD_API_PORT=4000
ASTROGUARD_ALLOWED_ORIGINS=http://localhost:3000

# Set to route the client at the Express API instead of Next route handlers,
# e.g. http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=
